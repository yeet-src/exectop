# build artifacts
/node_modules/
/src/index.jsx
/.build/

# compiled BPF objects + generated CO-RE header
/bin/*
!/bin/.gitkeep
# The launcher is source, not a build artifact. Launch mode has to spawn a
# process and a yeet isolate deliberately cannot, so this wrapper owns the
# SIGSTOP handoff that makes the process tree complete.
!/bin/exectop
/src/bpf/include/vmlinux.h

# kernel-matrix run output (build/kernel-matrix.sh)
/.kmatrix/
